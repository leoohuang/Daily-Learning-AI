knitr::opts_chunk$set(echo = TRUE)
library('tidyverse')
theme_set(theme_bw())
pop_mean <- 20
pop_sd <- 5
samp <- rnorm(100, mean = pop_mean, sd = pop_sd)
mean(samp)
sd(samp)
n <- 100 # Sample size
samp_distr <- replicate(1e5, mean(rnorm(n, pop_mean, pop_sd)))
length(samp_distr)
head(samp_distr)
hist(samp_distr)
mean(samp_distr)
sd(samp_distr)
se <- pop_sd/sqrt(100)
ci95_lo <- pop_mean-1.96*se
ci95_hi <- pop_mean+1.96*se
sum(samp_distr > ci95_lo & samp_distr < ci95_hi)/length(samp_distr)
samp <- rnorm(100,pop_mean,pop_sd)
sample_mean <- mean(samp)
se <- pop_sd/sqrt(100)
z <- (sample_mean - pop_mean)/se
z
samp_false <- rnorm(100,mean=10,sd=5)
z_false <- (mean(samp_false)-20)/(5/sqrt(100))
samp_false <- rnorm(100,mean=10,sd=5)
z_false <- (mean(samp_false)-20)/(5/sqrt(100))
z
samp_false <- rnorm(100,mean=10,sd=5)
z_false <- (mean(samp_false)-20)/(5/sqrt(100))
z_false
mean(samp) + c(-1.96,1.96)*se
samp <- rnorm(100, pop_mean, pop_sd)
mean(samp) + c(-1.96, 1.96) * se
plot_t_crit(0.95)
samp_sd <- sd(samp)
se_est <- samp_sd /sqrt(length(samp))
t_val <- (mean(samp) - pop_mean)/se_est
plot_t_crit(0.95)
plot_t_crit(0.95)  # 绘制t分布的临界值
t.test(samp,mu = 20)
samp_false <- rnorm(100, mean = 15, sd = 5)
t.test(samp_false, mu = 20)
t.test(x1,x2)
x1 <- rnorm(50.0,1)
x2 <- rnorm(50,4,1)
t.test(x1,x2)
d <- tibble(x = c(x1,x2), group = rep(c('A','B'),each = 50))
t.test(x~group,d)
x1_true <- rnorm(50, 0, 1)
x2_true <- rnorm(50, 0, 1)
t.test(x1_true, x2_true)
model <- lm(meanSizeRating ~ Class, data = ratings)  # 拟合回归模型
knitr::opts_chunk$set(echo = TRUE)
library('tidyverse')
theme_set(theme_bw())
source('08-inferential1-utils.R')  # 加载课程专用的辅助函数
set.seed(500)  # 固定随机数生成器，确保结果可重复
pop_mean <- 20
pop_sd <- 5
samp <- rnorm(100, mean = pop_mean, sd = pop_sd)
mean(samp)
sd(samp)
n <- 100 # Sample size
samp_distr <- replicate(1e5, mean(rnorm(n, pop_mean, pop_sd)))
length(samp_distr)
head(samp_distr)
hist(samp_distr)
mean(samp_distr)
sd(samp_distr)
se <- pop_sd/sqrt(100)
ci95_lo <- pop_mean-1.96*se
ci95_hi <- pop_mean+1.96*se
sum(samp_distr > ci95_lo & samp_distr < ci95_hi)/length(samp_distr)
samp <- rnorm(100,pop_mean,pop_sd)
sample_mean <- mean(samp)
se <- pop_sd/sqrt(100)
z <- (sample_mean - pop_mean)/se
samp_false <- rnorm(100,mean=10,sd=5)
z_false <- (mean(samp_false)-20)/(5/sqrt(100))
z_false
mean(samp) + c(-1.96,1.96)*se
samp <- rnorm(100, pop_mean, pop_sd)
mean(samp) + c(-1.96, 1.96) * se
t.test(samp,mu = 20)
samp_false <- rnorm(100, mean = 15, sd = 5)
t.test(samp_false, mu = 20)
x1 <- rnorm(50.0,1)
x2 <- rnorm(50,4,1)
t.test(x1,x2)
d <- tibble(x = c(x1,x2), group = rep(c('A','B'),each = 50))
t.test(x~group,d)
x1_true <- rnorm(50, 0, 1)
x2_true <- rnorm(50, 0, 1)
t.test(x1_true, x2_true)
model <- lm(meanSizeRating ~ Class, data = ratings)  # 拟合回归模型
library('languageR')
data(ratings)
ratings %>% select(Word, Class, meanSizeRating) %>% head()  # 查看数据
# 两样本t检验
t.test(meanSizeRating ~ Class, data = ratings)
model <- lm(meanSizeRating ~ Class, data = ratings)  # 拟合回归模型
summary(model)  # 查看回归结果
