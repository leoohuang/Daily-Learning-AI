knitr::opts_chunk$set(echo = TRUE)
library('knitr')
options(width=80)
opts_chunk$set(tidy=FALSE, size='footnotesize', fig.align='center', out.width='0.8\\textwidth', cache=FALSE)
library('tidyverse')
theme_set(theme_bw())
library('broom')
set.seed(500)
m <- lm(y~x,samp)
beta0 = 3   # Intercept
beta1 = -2  # Slope
n <- 50 # Sample size
samp <- tibble(x = rnorm(n),
y = beta0 + beta1 * x + rnorm(n))
m <- lm(y~x,samp)
coefficients(m)
ggplot(samp,aes(x,y)) +
geom_point()+
geom_smooth(method = 'lm',se = FALSE, color = 'black') +
geom_abline(slope = beta1, intercept = beta0,color = 'red',linewidth = 1)
ggplot(samp,aes(x,y))+
geom_point()+
geom_smooth(method = 'lm',color = 'black') +
geom_abline(slope = beta1, intercept = beta0, color = 'red',linewidth = 1)
n <- 30
d <- tibble(
x1 = rnorm(n),
x2 = rnorm(n),
x3 = rnorm(n),
y = 2 + 10*x1 + 0.5*x2 + rnorm(n)
)
m <- lm(y~x1+x2+x3,d)
summary(m)
tidy(m)
tidy(m) %>%
mutate(statistic_manual = estimate/std.error) %>%
select(statistic, statistic_manual)
library(languageR)
data(lexdec)
lexdec <- lexdec %>%
group_by(Word) %>%
summarise(
Frequency = first(Freguency),
meanSize = first(meanSize),
RT = mean(RT)
)
library(languageR)
data(lexdec)
lexdec <- lexdec %>%
group_by(Word) %>%
summarise(
Frequency = first(Frequency),
meanSize = first(meanSize),
RT = mean(RT)
)
m_lex <- lm(RT~Frequency + meanSize, lexdec)
tidy(m_lex)
n <- 30
d <- tibble(
x1 = rnorm(n),
x2 = rnorm(n,0, 0.5),
x3 = rnorm(n),
y = 2 + 10*x1 + 0.5*x2 +rnorm(n)
)
tidy(lm(y~x1+x2+x3,d))
n <- 50
d <- tibble(x = rnorm(n), y = -4 + 2*x +rnorm(n))
tidy(lm(y~x,d))
d_cat3 <- tibble(
score = c(rnorm(50,10,1),rnorm(50,9,1),rnorm(50,10,1)),
group = rep(c('A','B','C'), each = 50)
)
ggplot(d_cat3,aes(score~group)) + geom_boxplot()
t.test(score ~ group,d_cat,var.equal = TRUE)
