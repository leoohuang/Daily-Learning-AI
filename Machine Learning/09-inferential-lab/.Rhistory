n <- 30
d <- tibble(
x1 = rnorm(n),
x2 = rep(c('A','B','C'), each = 10),
y = ifelse(x2 == 'B',7,-1) + 4*x1 +rnorm(n)
)
m_full <- lm(y~x1+x2,d)
m_reduced <- lm(y~x1,d)
anova(m_full,m_reduced)
d <- d%>%
mutate(x2 = fct_relevel(x2,'B'))
m_full_new <- lm(y~x1+x2,d)
anova(m_full_new, m_reduced)
