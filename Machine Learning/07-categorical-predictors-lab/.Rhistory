knitr::opts_chunk$set(echo = TRUE)
library('tidyverse')
theme_set(theme_bw())
d <- d%>%
mutate(group = as_factor(group))
d <- tibble(score = c(rnorm(30,5,4),rnorm(30,3,4)),
group = rep(c('A','B'),each = 30))
head(d)
tail(d)
d <- d %>%
mutate(group = as_factor(group))
d$group
ggplot(d,aes(x = group, y= score)) +
geom_boxplot()
d %>%
group_by(group)%>%
summarise(mean_score = mean(score))
d <- d%>%
mutate(group = fct_relevel(group, 'B'))
levels(d$group)
ggplot(d3,aes(group,score))+
geom_boxplot()
knitr::opts_chunk$set(echo = TRUE)
library('tidyverse')
theme_set(theme_bw())
d <- tibble(score = c(rnorm(30,5,4),rnorm(30,3,4)),
group = rep(c('A','B'),each = 30))
head(d)
tail(d)
d <- d %>%
mutate(group = as_factor(group))
d$group
ggplot(d,aes(x = group, y= score)) +
geom_boxplot()
m1 <- lm(score ~ group, d)
summary(m1)
d %>%
group_by(group)%>%
summarise(mean_score = mean(score))
d <- d%>%
mutate(group = fct_relevel(group, 'B'))
levels(d$group)
m2 <- lm(score~group,d)
coefficients(m2)
d3 <- tibble(score = c(rnorm(30,-5,2), nrorm(30,2,2), rnorm(30,8,2)),
group = rep(c('A','B','C'),each = 30))
d3 <- tibble(score = c(rnorm(30,-5,2), rnorm(30,2,2), rnorm(30,8,2)),
group = rep(c('A','B','C'),each = 30))
d3 <- d3 %>%
mutate(group = as_factor(group))
levels(d3$group)
ggplot(d3,aes(group,score))+
geom_boxplot()
m3 <- lm(score ~ group,d3)
summary(m3)
d3 %>%
group_by(group) %>%
summarise(mean_score = mean(score))
d3 <- d3 %>%
mutate(group = fct_relevel(group,'B'))
m4 <- lm(score ~ group,d3)
summary(m4)
res <- residuals(m4)
hist(res)
qqnorm(res)
qqline(res)
fitted_vals <- fitted(m4)
plot(fitted_vals, res)
d3 %>%
group_by(group) %>%
summarise(mean_score = mean(score))
