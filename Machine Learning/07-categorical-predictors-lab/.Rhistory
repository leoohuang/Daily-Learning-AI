library(languageR)
data(lexdec)
words <- lexdec %>%
group_by(Word) %>%
summarise(Class = first(Class),
Frequency = first(Frequency),
Length = first(Length),
RT = mean(RT))
lexdec_m <- lm(RT~Frequency + Class, words)
summary(lexdec_m)
lexdec_m_z <- lm(RT ~ frequency_z + Class, words)
lexdec_m_z <- lm(RT ~ frequency_z + Class, words)
lexdec_m_z <- lm(RT ~ Frequency_z + Class, words)
words <- words %>%
mutate(Frequency_z = scale(Frequency))
lexdec_m_z <- lm(RT ~ Frequency_z + Class, words)
summary(lexdec_m_z)$coef
m_length <- lm(RT~Frequency + Class + Length,words)
summary(m_Length)$coef
m_length <- lm(RT~Frequency + Class + Length,words)
summary(m_length)$coef
